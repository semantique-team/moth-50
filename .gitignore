data/manifests/cs-fleurs-read.jsonl
runs/**/checkpoints/
*.onnx
*.pt
*.safetensors

.DS_Store
.idea/
.vscode/

# Derived release packages (large binaries); keep the export report
runs/**/release/
runs/**/release-*/
# Derived LM binaries: regenerate with tools/pack_lm.py or tools/build_lm.py
runs/**/*.bin
runs/**/*.pkl.gz
# Live resource monitoring and its generated dashboard
runs/**/resource-samples.jsonl
runs/**/resource-dashboard.html

# Training process bookkeeping (the trainer's own log stays tracked)
runs/**/console.log
runs/**/launcher.pid
runs/**/sampler.pid
runs/**/sampler.log
runs/**/caffeinate.pid
